# Heavy Edition - برای پروژه‌های غول و مونورپو
FROM node:22-bookworm

RUN apt-get update && apt-get install -y \
    git bash python3 build-essential curl jq htop ripgrep fd-find \
    ccache tzdata \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=Asia/Tehran
ENV NODE_OPTIONS="--max-old-space-size=8192 --max-semi-space-size=128"
ENV NPM_CONFIG_FUND=false

WORKDIR /app

# نصب Pi و Pi-Web
RUN npm install -g @earendil-works/pi-coding-agent @jmfederico/pi-web --allow-scripts=node-pty

# همه اکستنشن‌های Ultimate + بهینه برای پروژه سنگین
RUN pi install npm:billion-context && \
    pi install npm:pi-hermes-memory && \
    pi install npm:pi-web-access && \
    pi install npm:pi-subagents && \
    pi install npm:pi-mcp-adapter && \
    pi install npm:pi-lens && \
    pi install npm:pi-agent-browser-native && \
    pi install npm:@gwynnnplaine/pi-github && \
    pi install npm:@feniix/pi-devtools && \
    pi install npm:@piex-dev/dap && \
    pi install npm:cc-safety-net && \
    pi install npm:@oisin-ee/pi-guardrails && \
    pi install npm:pi-goal && \
    pi install npm:pi-autoresearch && \
    pi install npm:@juicesharp/rpiv-ask-user-question && \
    pi install npm:pi-total-recall && \
    pi install npm:pi-observational-memory && \
    pi install npm:@vtstech/pi-long-term-memory || true

COPY config.heavy.json /app/config.json
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

VOLUME ["/data"]

ENV PI_WEB_HOST=0.0.0.0
ENV PI_WEB_CONFIG=/app/config.json
ENV NODE_ENV=production

EXPOSE 8504

# Healthcheck سنگین - پروژه سنگین دیر بالا میاد
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:${PORT:-8504}/ || exit 1

CMD ["/app/start.sh"]
